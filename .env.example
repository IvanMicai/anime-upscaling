# Host directory that contains input/output media.
# The container sees this directory mounted at PROCESS_DIR.
HOST_PROCESS_DIR=./data
PROCESS_DIR=/data

# Ports
API_PORT=4751
APP_PORT=4750

# Optional when running docker-compose.hub.yml with published Docker Hub images.
# DOCKERHUB_NAMESPACE=your-dockerhub-user-or-org
# IMAGE_TAG=latest
# API image tag when it differs, e.g. seedvr2 for the SeedVR2 variant.
# API_IMAGE_TAG=seedvr2

# Web app authentication.
# Replace both values before exposing the app outside a trusted local network.
AUTH_PASSWORD=change-me
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# API URL used by the Next.js app inside Docker Compose.
API_URL=http://api:4751

# Worker concurrency.
GPU_COUNT=1
STREAMS_PER_GPU=1
FFMPEG_STREAMS=1

# Optional hardware encoder for optimize jobs: nvidia, amd, intel, or empty.
GPU_VENDOR=

# SeedVR2 (only with the seedvr2 API image). The defaults are tuned for a
# 16 GB GPU; an out-of-memory run is retried once with the safest settings.
# SEEDVR2_BATCH_SIZE=13          # frames per temporal batch, must be 4n+1
# SEEDVR2_BLOCKS_TO_SWAP=20      # model blocks kept in system RAM (7B: 0-36, 3B: 0-32)
# SEEDVR2_EXTRA_ARGS=            # extra inference_cli.py flags, e.g. --attention_mode sageattn_2
# Weights download on first use into $PROCESS_DIR/models/seedvr2 (~9 GB for 7B).
# Block swapping moves model weights to system RAM: give the API room
# (API_MEM_LIMIT of 32g or more when two GPUs run SeedVR2 at once).

# Container memory limits (Docker mem_limit syntax: e.g. 8g, 16g, 24g).
# Caps process+ffmpeg+CUDA RSS so the OOM killer reaps the container instead
# of the host kernel/system services. Tune to leave headroom for ZFS ARC and
# other workloads on the host.
API_MEM_LIMIT=16g
APP_MEM_LIMIT=1g
